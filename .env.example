# API is reachable via same-origin /api/v1 by default. In development Vite proxies it.
VITE_API_BASE_URL=/api/v1
VITE_DEV_API_TARGET=http://localhost:3000

# A different API origin is possible but requires HTTPS, CORS, credentialed requests
# and compatible cookie SameSite settings. Prefer same-origin reverse proxy.
# Never put session tokens, PostgreSQL credentials or S3 keys in VITE_* variables.
