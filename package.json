{
  "packageManager": "bun@1.4.4",
  "license": "UNLICENSED",
  "scripts": {
    "build": "vite build",
    "build-storybook": "storybook build",
    "check:release": "node scripts/check-release.mjs",
    "dev": "vite --host 0.0.0.0 --port 8080",
    "lint": "eslint . --fix",
    "lint:prettier": "bun run lint && bun run prettier",
    "prettier": "prettier --write \"src/**/*.{ts,vue,css,json}\"",
    "preview": "vite preview --host 127.0.0.1 --port 8080",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "test:all": "vitest run src",
    "test:browser": "playwright test",
    "test:e2e": "playwright test",
    "test:lifeboard": "vitest run src/modules/lifeboard",
    "test:shared": "vitest run src/shared",
    "test:unit": "vitest run --coverage"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@primeuix/themes": "2.0.3",
    "@vueuse/core": "^14.2.1",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",
    "grid-layout-plus": "1.1.1",
    "pinia": "^3.0.4",
    "primevue": "^4.5.5",
    "vue": "^3.5.33",
    "vue-i18n": "^11.4.0",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@tailwindcss/postcss": "4.2.4",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.8",
    "autoprefixer": "^10.5.0",
    "cypress": "^15.14.1",
    "eslint": "^10.2.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.12",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.2.4",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.2.0",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^4.1.5",
    "storybook": "^10.6.2",
    "@storybook/vue3-vite": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-a11y": "^10.6.2",
    "@playwright/test": "^1.56.0"
  },
  "name": "lifeboard",
  "version": "1.0.0",
  "private": true
}
